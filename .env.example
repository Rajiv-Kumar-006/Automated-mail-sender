# =================================================================
# SMTP Configuration
# =================================================================
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465 (for SSL) or 587 (for TLS)
#   SMTP_SECURE=true (true for 465, false for 587)
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_16_digit_google_app_password
#   (Generate App Password at: https://myaccount.google.com/apppasswords)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# =================================================================
# Sender Identity & Profile Information
# =================================================================
SENDER_NAME=Rajiv Kumar
SENDER_EMAIL=your_email@gmail.com
SENDER_TITLE=Software Engineer / Full Stack Developer
SENDER_PHONE=+91 9876543210
SENDER_LINKEDIN=https://www.linkedin.com/in/yourprofile
SENDER_PORTFOLIO=https://yourportfolio.dev
SENDER_GITHUB=https://github.com/yourhandle
SENDER_YEARS_OF_EXP=2+ years
SENDER_KEY_SKILLS=Node.js, React, JavaScript, TypeScript, REST APIs, MongoDB, SQL

# Email Subject Line (Supports <%= companyName %> variable)
EMAIL_SUBJECT=Application for Software Engineer Opportunities - <%= companyName %>

# =================================================================
# Rate Limiting & Sending Control
# =================================================================
# Delay between each email in milliseconds (1000 = 1 second)
DELAY_BETWEEN_EMAILS_MS=1000

# Set to true to simulate sending without actually sending emails
DRY_RUN=false

# Max emails to send in this run (0 or blank for no limit / send all)
MAX_EMAILS_TO_SEND=0

# =================================================================
# Attachments (Optional)
# =================================================================
# Path to your resume PDF (relative to project root)
# Place your PDF inside the 'attachments' folder
ATTACH_RESUME=true
RESUME_FILE_PATH=./attachments/Resume.pdf
RESUME_DISPLAY_NAME=Rajiv_Kumar_Resume.pdf

# =================================================================
# CSV Data File Path
# =================================================================
CSV_FILE_PATH=./23800+ Ultimate HR Outreach List - DataNiti - 3000+ HR's with Profiles - Weekly Updates.csv
